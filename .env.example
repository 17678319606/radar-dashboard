# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，切勿提交到仓库）
# 密钥也可存入 macOS 钥匙串：security add-generic-password -s radar-dashboard -a DEEPSEEK_API_KEY -w "sk-你的key"
# 本地脚本会按：环境变量 → .env → ~/.hermes/.env → ~/.env → macOS 钥匙串 的顺序读取

DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# —— 以下为 daily_signals.py 扩展信号源（留空则对应源自动跳过）——
# trustmrr.com 付费信号源（可选）
TRUSTMRR_API_KEY=
# Product Hunt GraphQL（可选，需要 token）
PH_TOKEN=
# Reddit 应用凭据（可选，用于 r/SideProject、r/SaaS 抓取）
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
